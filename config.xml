<?xml version="1.0" encoding="utf-8"?>
<widget id="com.trapbound.fatdash" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Trapbound: Fat Dash</name>
    <description>Original 500-level surprise platformer.</description>
    <author email="developer@example.com" href="https://cordova.apache.org">Trapbound Studio</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="landscape" />
    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="WebViewBounce" value="false" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
    <preference name="SplashScreenDelay" value="0" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="android-installLocation" value="auto" />
    </platform>
    <engine name="android" spec="15.1.0" />
</widget>
